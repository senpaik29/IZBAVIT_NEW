---
import "~/styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "IzbaVit — VIP-приём Ксении Ерофеевой в станице Смоленская. Глубокая системная перезагрузка тела: висцеральная и вакуумная терапия, фитобочка, ЛФК, психосоматика, питание на эко-продуктах.",
} = Astro.props;
---

<!doctype html>
<html class="scroll-smooth" lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#7d562d" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <title>{title}</title>

    <script
      is:inline
      src="https://cdn.tailwindcss.com?plugins=forms,container-queries"
    ></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700&family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
    />

    <script is:inline id="tailwind-config">
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            colors: {
              background: "#fdfae7",
              surface: "#fdfae7",
              "surface-bright": "#fdfae7",
              "surface-dim": "#dddbc8",
              "surface-container-lowest": "#ffffff",
              "surface-container-low": "#f7f4e1",
              "surface-container": "#f1eedb",
              "surface-container-high": "#ece9d6",
              "surface-container-highest": "#e6e3d0",
              "surface-variant": "#e6e3d0",
              "on-surface": "#1c1c11",
              "on-surface-variant": "#50453b",
              "on-background": "#1c1c11",
              "inverse-surface": "#313124",
              "inverse-on-surface": "#f4f1de",
              outline: "#82756a",
              "outline-variant": "#d4c4b7",
              "surface-tint": "#7d562d",
              primary: "#7d562d",
              "on-primary": "#ffffff",
              "primary-container": "#d4a373",
              "on-primary-container": "#5b3912",
              "inverse-primary": "#f0bd8b",
              "primary-fixed": "#ffdcbd",
              "primary-fixed-dim": "#f0bd8b",
              "on-primary-fixed": "#2c1600",
              "on-primary-fixed-variant": "#623f18",
              secondary: "#765a05",
              "on-secondary": "#ffffff",
              "secondary-container": "#ffd87c",
              "on-secondary-container": "#795d08",
              "secondary-fixed": "#ffdf96",
              "secondary-fixed-dim": "#e7c268",
              "on-secondary-fixed": "#251a00",
              "on-secondary-fixed-variant": "#5a4400",
              tertiary: "#655d51",
              "on-tertiary": "#ffffff",
              "tertiary-container": "#b4ab9d",
              "on-tertiary-container": "#464034",
              "tertiary-fixed": "#ece1d2",
              "tertiary-fixed-dim": "#cfc5b6",
              "on-tertiary-fixed": "#201b12",
              "on-tertiary-fixed-variant": "#4c463b",
              error: "#ba1a1a",
              "error-container": "#ffdad6",
              "on-error": "#ffffff",
              "on-error-container": "#93000a",
              "text-charcoal": "#1c1c11",
              "gold-muted": "#7d562d",
              "text-sage": "#655d51",
            },
            borderRadius: {
              DEFAULT: "0.25rem",
              lg: "0.5rem",
              xl: "0.75rem",
              "2xl": "1rem",
              full: "9999px",
            },
            spacing: {
              "container-max": "1200px",
              "margin-desktop": "64px",
              "margin-mobile": "16px",
              "section-gap": "120px",
              "section-gap-sm": "80px",
              "section-gap-lg": "120px",
              gutter: "24px",
              unit: "8px",
              "stack-sm": "8px",
              "stack-md": "16px",
              "stack-lg": "24px",
            },
            fontFamily: {
              "body-md": ["Plus Jakarta Sans", "Manrope"],
              "body-lg": ["Plus Jakarta Sans", "Manrope"],
              "display-hero": ["Manrope"],
              "display-hero-mobile": ["Manrope"],
              "headline-lg": ["Manrope"],
              "headline-lg-mobile": ["Manrope"],
              "headline-md": ["Manrope"],
              "headline-sm": ["Manrope"],
              "label-caps": ["Manrope"],
              "stat-number": ["Manrope"],
            },
            fontSize: {
              "body-md": ["16px", { lineHeight: "1.6", fontWeight: "400" }],
              "body-lg": ["18px", { lineHeight: "1.6", fontWeight: "400" }],
              "display-hero": [
                "48px",
                { lineHeight: "56px", letterSpacing: "-0.02em", fontWeight: "300" },
              ],
              "display-hero-mobile": [
                "40px",
                { lineHeight: "1.2", fontWeight: "600" },
              ],
              "headline-lg": [
                "32px",
                { lineHeight: "40px", letterSpacing: "-0.01em", fontWeight: "500" },
              ],
              "headline-lg-mobile": [
                "28px",
                { lineHeight: "36px", fontWeight: "500" },
              ],
              "headline-md": ["32px", { lineHeight: "1.3", fontWeight: "500" }],
              "headline-sm": ["24px", { lineHeight: "1.4", fontWeight: "600" }],
              "label-caps": [
                "12px",
                { lineHeight: "16px", letterSpacing: "0.05em", fontWeight: "600" },
              ],
              "stat-number": ["40px", { lineHeight: "1", fontWeight: "600" }],
            },
          },
        },
      };
    </script>
    <style is:inline>
      body {
        background-color: #fdfae7;
        color: #1c1c11;
        -webkit-font-smoothing: antialiased;
      }
      .material-symbols-outlined {
        font-variation-settings:
          "FILL" 0,
          "wght" 400,
          "GRAD" 0,
          "opsz" 24;
      }
      .glass-card {
        background: rgba(253, 250, 231, 0.7);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(125, 86, 45, 0.1);
      }
    </style>
  </head>
  <body
    class="bg-surface text-on-surface font-body-md text-body-md selection:bg-primary selection:text-on-primary"
  >
    <slot />

    <script is:inline>
      document.addEventListener("DOMContentLoaded", () => {
        const revealObserver = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("active");
                revealObserver.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.15, rootMargin: "0px 0px -50px 0px" },
        );

        document.querySelectorAll(".reveal").forEach((el) => {
          const parent = el.parentElement;
          if (
            parent &&
            (parent.classList.contains("grid") ||
              parent.classList.contains("space-y-gutter") ||
              parent.classList.contains("space-y-12"))
          ) {
            const idx = Array.from(parent.children).indexOf(el);
            if (idx !== -1) el.style.transitionDelay = `${idx * 0.1}s`;
          }
          revealObserver.observe(el);
        });
      });
    </script>
  </body>
</html>
