---
// Форма уходит через FormSubmit (formsubmit.co) — заявки доставляются на
// senpaik29@gmail.com. Первое сообщение придёт как письмо-активация: нужно
// один раз кликнуть в нём по ссылке, после этого все следующие заявки будут
// приходить автоматически.
const FORM_ACTION = "https://formsubmit.co/senpaik29@gmail.com";
// FormSubmit делает 302 на этот URL после успешной отправки. Astro.site нужен,
// потому что _next требует абсолютный URL. BASE_URL в продакшен-сборке отдаётся
// без завершающего слэша, поэтому строим путь явно через split-rejoin.
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const NEXT_URL = new URL(`${base}/thank-you`, Astro.site).toString();
---

<section
  class="py-section-gap-lg bg-primary-container text-on-primary-container scroll-mt-32"
  id="contact"
>
  <div class="max-w-[1000px] px-margin-mobile md:px-gutter">
    <div class="grid md:grid-cols-2 gap-16 items-start">
      <div class="reveal">
        <h2
          class="font-headline-lg text-headline-lg-mobile md:text-headline-lg mb-8 text-on-primary-container"
        >
          Готовы к <br />
          <span class="text-primary italic font-normal">перезагрузке?</span>
        </h2>
        <p class="text-on-primary-container/70 mb-12">
          Оставьте заявку или напишите нам напрямую — обсудим формат, цены и
          подберём оптимальную программу под ваш запрос.
        </p>
        <div class="space-y-8">
          <a
            class="flex items-center gap-6 group"
            href="tel:+79155889235"
          >
            <span
              class="material-symbols-outlined text-primary text-3xl group-hover:scale-110 transition-transform"
              >call</span
            >
            <div>
              <p
                class="font-label-caps text-label-caps text-on-primary-fixed-variant"
              >
                Телефон
              </p>
              <span class="text-xl font-bold text-on-primary-container">
                +7 915 588-92-35
              </span>
            </div>
          </a>
          <a
            class="flex items-center gap-6 group"
            href="https://t.me/guru_banok"
            rel="noopener"
            target="_blank"
          >
            <span
              class="material-symbols-outlined text-primary text-3xl group-hover:scale-110 transition-transform"
              >send</span
            >
            <div>
              <p
                class="font-label-caps text-label-caps text-on-primary-fixed-variant"
              >
                Telegram
              </p>
              <span class="text-xl font-bold text-on-primary-container">
                Написать сразу
              </span>
            </div>
          </a>
          <div class="flex items-center gap-6">
            <span class="material-symbols-outlined text-primary text-3xl"
              >place</span
            >
            <div>
              <p
                class="font-label-caps text-label-caps text-on-primary-fixed-variant"
              >
                Локация
              </p>
              <p class="text-xl font-bold text-on-primary-container">
                Станица Смоленская, КК
              </p>
            </div>
          </div>
        </div>
      </div>
      <div class="bg-surface p-10 rounded-2xl shadow-xl reveal">
        <form
          class="space-y-6"
          action={FORM_ACTION}
          method="POST"
          autocomplete="on"
        >
          <input type="hidden" name="_subject" value="Новая заявка с сайта Izba.Vit" />
          <input type="hidden" name="_template" value="table" />
          <input type="hidden" name="_captcha" value="false" />
          <input type="hidden" name="_next" value={NEXT_URL} />
          <div>
            <label
              for="name"
              class="font-label-caps text-label-caps text-tertiary mb-2 block"
              >Имя</label
            >
            <input
              id="name"
              name="name"
              class="w-full bg-surface-container border-none rounded-lg focus:ring-1 focus:ring-primary p-4 text-on-surface"
              placeholder="Александр"
              type="text"
              required
            />
          </div>
          <div>
            <label
              for="phone"
              class="font-label-caps text-label-caps text-tertiary mb-2 block"
              >Телефон или Telegram</label
            >
            <input
              id="phone"
              name="contact"
              class="w-full bg-surface-container border-none rounded-lg focus:ring-1 focus:ring-primary p-4 text-on-surface"
              placeholder="+7 (___) ___-__-__ или @username"
              type="text"
              required
            />
          </div>
          <div>
            <label
              for="message"
              class="font-label-caps text-label-caps text-tertiary mb-2 block"
              >Ваш запрос (по желанию)</label
            >
            <textarea
              id="message"
              name="message"
              class="w-full bg-surface-container border-none rounded-lg focus:ring-1 focus:ring-primary p-4 text-on-surface"
              placeholder="Расскажите, что вас беспокоит, и какой формат интересует..."
              rows="4"></textarea>
          </div>

          {/* Honeypot: FormSubmit отбрасывает заявку, если это поле заполнено. */}
          <div
            aria-hidden="true"
            style="position:absolute;left:-10000px;width:1px;height:1px;overflow:hidden"
          >
            <label for="website">Не заполняйте это поле</label>
            <input
              id="website"
              name="_honey"
              type="text"
              tabindex="-1"
              autocomplete="off"
            />
          </div>

          <button
            class="w-full bg-primary text-on-primary py-5 rounded-lg font-bold hover:bg-on-primary-container hover:text-on-primary transition-all duration-300"
            type="submit"
          >
            Отправить заявку
          </button>
          <p class="text-[10px] text-on-surface-variant/40 text-center">
            Нажимая кнопку, вы соглашаетесь с политикой конфиденциальности.
          </p>
        </form>
      </div>
    </div>
  </div>
</section>
