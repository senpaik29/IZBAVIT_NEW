---
---

<section
  class="py-stack-lg relative overflow-hidden bg-charcoal-deep text-off-white"
  id="contact"
>
  <div
    class="absolute inset-0 opacity-10 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-emerald-electric via-transparent to-transparent"
  >
  </div>
  <div
    class="px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto relative z-10"
  >
    <div class="max-w-4xl mx-auto text-center reveal">
      <h2 class="font-display-lg text-display-lg mb-8">
        Готовы к <span class="text-emerald-electric">перезагрузке?</span>
      </h2>
      <p class="font-body-lg text-off-white/70 mb-12 max-w-2xl mx-auto">
        Оставьте заявку или позвоните — мы свяжемся, чтобы подобрать формат
        VIP-комплекса и ответить на все вопросы.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-gutter mb-stack-md text-left">
        <a
          class="reveal flex items-center gap-4 p-6 glass-nav rounded-xl border border-emerald-electric/20 hover:border-emerald-electric/60 transition-soft"
          href="tel:+79155889235"
        >
          <span class="material-symbols-outlined text-emerald-electric text-3xl">call</span>
          <div>
            <p class="font-label-sm text-label-sm text-charcoal-deep/60 uppercase tracking-widest">
              Записаться
            </p>
            <p class="font-headline-md text-xl text-charcoal-deep font-bold">
              +7 915 588-92-35
            </p>
          </div>
        </a>
        <div
          class="reveal flex items-center gap-4 p-6 glass-nav rounded-xl border border-emerald-electric/20"
        >
          <span class="material-symbols-outlined text-emerald-electric text-3xl">place</span>
          <div>
            <p class="font-label-sm text-label-sm text-charcoal-deep/60 uppercase tracking-widest">
              Локация
            </p>
            <p class="font-headline-md text-xl text-charcoal-deep font-bold">
              Станица Смоленская
            </p>
            <p class="font-body-md text-charcoal-deep/70">Краснодарский край</p>
          </div>
        </div>
        <div
          class="reveal flex items-center gap-4 p-6 glass-nav rounded-xl border border-emerald-electric/20"
        >
          <span class="material-symbols-outlined text-emerald-electric text-3xl">person</span>
          <div>
            <p class="font-label-sm text-label-sm text-charcoal-deep/60 uppercase tracking-widest">
              Формат
            </p>
            <p class="font-headline-md text-xl text-charcoal-deep font-bold">
              Только индивидуально
            </p>
            <p class="font-body-md text-charcoal-deep/70">VIP-приём 1 человек</p>
          </div>
        </div>
      </div>

      <form class="grid grid-cols-1 md:grid-cols-2 gap-gutter text-left">
        <div class="space-y-gutter">
          <div class="reveal">
            <label
              class="block font-label-sm text-label-sm text-off-white/50 mb-2 uppercase tracking-widest"
              for="name">Имя</label
            >
            <input
              id="name"
              class="w-full bg-transparent border-0 border-b border-off-white/20 focus:ring-0 focus:border-emerald-electric text-off-white font-body-lg py-4 transition-soft placeholder:text-off-white/20"
              placeholder="Александр"
              type="text"
            />
          </div>
          <div class="reveal">
            <label
              class="block font-label-sm text-label-sm text-off-white/50 mb-2 uppercase tracking-widest"
              for="phone">Телефон</label
            >
            <input
              id="phone"
              class="w-full bg-transparent border-0 border-b border-off-white/20 focus:ring-0 focus:border-emerald-electric text-off-white font-body-lg py-4 transition-soft placeholder:text-off-white/20"
              placeholder="+7 (___) ___-__-__"
              type="tel"
            />
          </div>
        </div>
        <div class="flex flex-col reveal">
          <label
            class="block font-label-sm text-label-sm text-off-white/50 mb-2 uppercase tracking-widest"
            for="message">Ваш запрос (по желанию)</label
          >
          <textarea
            id="message"
            class="w-full bg-transparent border-0 border-b border-off-white/20 focus:ring-0 focus:border-emerald-electric text-off-white font-body-lg py-4 transition-soft resize-none placeholder:text-off-white/20 flex-grow"
            placeholder="Опишите ваш запрос или предпочтительный формат..."
            rows="4"></textarea>
        </div>
        <div class="md:col-span-2 mt-8 reveal">
          <button
            class="w-full bg-emerald-electric text-charcoal-deep font-bold py-6 rounded-full text-xl vibrating-button transition-soft hover:shadow-[0_0_40px_rgba(0,217,126,0.4)]"
            type="submit"
          >
            Отправить заявку
          </button>
          <p
            class="text-center font-label-sm text-label-sm text-off-white/40 mt-6"
          >
            Нажимая кнопку, вы соглашаетесь с политикой конфиденциальности.
          </p>
        </div>
      </form>
    </div>
  </div>
</section>
