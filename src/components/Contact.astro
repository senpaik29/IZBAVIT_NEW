---
---

<section
  class="py-section-gap-lg bg-primary-container text-on-primary-container"
  id="contact"
>
  <div class="max-w-[1000px] mx-auto px-margin-mobile md:px-gutter">
    <div class="grid md:grid-cols-2 gap-16 items-start">
      <div class="reveal">
        <h2
          class="font-headline-lg text-headline-lg-mobile md:text-headline-lg mb-8 text-on-primary-container"
        >
          Готовы к <br />
          <span class="text-primary italic font-normal">перезагрузке?</span>
        </h2>
        <p class="text-on-primary-container/70 mb-12">
          Оставьте заявку или позвоните — мы свяжемся, чтобы подобрать формат
          VIP-комплекса.
        </p>
        <div class="space-y-8">
          <div class="flex items-center gap-6">
            <span class="material-symbols-outlined text-primary text-3xl"
              >call</span
            >
            <div>
              <p
                class="font-label-caps text-label-caps text-on-primary-fixed-variant"
              >
                Телефон
              </p>
              <a
                class="text-xl font-bold text-on-primary-container"
                href="tel:+79155889235"
              >
                +7 915 588-92-35
              </a>
            </div>
          </div>
          <div class="flex items-center gap-6">
            <span class="material-symbols-outlined text-primary text-3xl"
              >place</span
            >
            <div>
              <p
                class="font-label-caps text-label-caps text-on-primary-fixed-variant"
              >
                Локация
              </p>
              <p class="text-xl font-bold text-on-primary-container">
                Станица Смоленская, КК
              </p>
            </div>
          </div>
          <div class="flex items-center gap-6">
            <span class="material-symbols-outlined text-primary text-3xl"
              >person</span
            >
            <div>
              <p
                class="font-label-caps text-label-caps text-on-primary-fixed-variant"
              >
                Формат
              </p>
              <p class="text-xl font-bold text-on-primary-container">
                Индивидуальный VIP-приём
              </p>
            </div>
          </div>
        </div>
      </div>
      <div class="bg-surface p-10 rounded-2xl shadow-xl reveal">
        <form class="space-y-6">
          <div>
            <label
              for="name"
              class="font-label-caps text-label-caps text-tertiary mb-2 block"
              >Имя</label
            >
            <input
              id="name"
              class="w-full bg-surface-container border-none rounded-lg focus:ring-1 focus:ring-primary p-4 text-on-surface"
              placeholder="Александр"
              type="text"
            />
          </div>
          <div>
            <label
              for="phone"
              class="font-label-caps text-label-caps text-tertiary mb-2 block"
              >Телефон</label
            >
            <input
              id="phone"
              class="w-full bg-surface-container border-none rounded-lg focus:ring-1 focus:ring-primary p-4 text-on-surface"
              placeholder="+7 (___) ___-__-__"
              type="tel"
            />
          </div>
          <div>
            <label
              for="message"
              class="font-label-caps text-label-caps text-tertiary mb-2 block"
              >Ваш запрос (по желанию)</label
            >
            <textarea
              id="message"
              class="w-full bg-surface-container border-none rounded-lg focus:ring-1 focus:ring-primary p-4 text-on-surface"
              placeholder="Расскажите, что вас беспокоит..."
              rows="4"></textarea>
          </div>
          <button
            class="w-full bg-primary text-on-primary py-5 rounded-lg font-bold hover:bg-on-primary-container hover:text-on-primary transition-all duration-300"
            type="submit"
          >
            Отправить заявку
          </button>
          <p class="text-[10px] text-on-surface-variant/40 text-center">
            Нажимая кнопку, вы соглашаетесь с политикой конфиденциальности.
          </p>
        </form>
      </div>
    </div>
  </div>
</section>
