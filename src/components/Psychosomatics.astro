---
const evgeniyImg =
  "https://lh3.googleusercontent.com/aida-public/AB6AXuBsnQE2SxnvYv28Zd64jWkt39DBi8tnnHZ7lFZ5H7hqrHX7REMj5ODc3s04SiamyC0_vGtO4zg_rRNRjgBx6ZSUUfz0gU_z1oPcWFy4Ju112SMs_A3XLXdYeQ7N235pGFkNChtUza4crFIBC-hlXn2qHFKVKELbAVMaM1YcSghxjYlo-TPJxips6in9Wdb-dY5uJNqn6AZcF-EG5Yje60TTld-S984jN8uUYC49EuVrpabOpMHLMYcuzSq6G7CpQBrDpP19tOARDNo";
---

<section class="py-section-gap-lg bg-surface-container-high overflow-hidden">
  <div class="max-w-container-max mx-auto px-margin-mobile md:px-gutter relative">
    <div class="grid md:grid-cols-2 gap-16 items-center">
      <div class="relative z-10 reveal">
        <span
          class="font-label-caps text-label-caps text-primary mb-4 block uppercase"
          >Психосоматика</span
        >
        <h2
          class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-surface mb-10"
        >
          За каждым диагнозом <br />
          <span class="text-primary italic font-normal">стоит событие</span>
        </h2>
        <div class="space-y-12">
          <div class="border-l-2 border-primary/30 pl-8">
            <h4 class="font-headline-sm text-headline-sm text-on-surface mb-4">
              Тело не болеет случайно
            </h4>
            <p class="text-on-surface-variant">
              Любой симптом — это адаптационная реакция организма. Стрессовое
              событие запускает цепочку: психика → мозг → тело.
            </p>
          </div>
          <div class="border-l-2 border-primary/30 pl-8">
            <h4 class="font-headline-sm text-headline-sm text-on-surface mb-4">
              Мир в душе — это физиология
            </h4>
            <p class="text-on-surface-variant">
              Когда конфликт разрешён, тело перестаёт удерживать напряжение, и
              запускаются процессы естественного восстановления.
            </p>
          </div>
        </div>
      </div>
      <div class="flex flex-col gap-8 reveal">
        <div class="relative">
          <div class="aspect-[4/5] rounded-2xl overflow-hidden shadow-xl">
            <img
              alt="Евгений Ерофеев"
              class="w-full h-full object-cover"
              src={evgeniyImg}
            />
          </div>
          <div
            class="absolute -bottom-6 -right-6 bg-primary text-on-primary p-6 rounded-xl shadow-lg hidden md:block"
          >
            <p class="font-headline-sm text-[20px] mb-1">Евгений Ерофеев</p>
            <p class="font-label-caps text-[10px] text-on-primary/80">
              Специалист по психосоматике
            </p>
          </div>
        </div>
        <div class="bg-surface/50 p-8 rounded-2xl border border-outline/10">
          <div class="grid gap-6">
            <div class="flex gap-4">
              <span class="material-symbols-outlined text-primary">science</span>
              <div>
                <h5 class="text-on-surface font-bold mb-1">Без мистики</h5>
                <p class="text-sm text-on-surface-variant">
                  Только ясная логика, понятная телу и уму.
                </p>
              </div>
            </div>
            <div class="flex gap-4">
              <span class="material-symbols-outlined text-primary"
                >account_tree</span
              >
              <div>
                <h5 class="text-on-surface font-bold mb-1">
                  Причинно-следственная связь
                </h5>
                <p class="text-sm text-on-surface-variant">
                  Находим событие — убираем причину напряжения.
                </p>
              </div>
            </div>
            <div class="flex gap-4">
              <span class="material-symbols-outlined text-primary"
                >psychology</span
              >
              <div>
                <h5 class="text-on-surface font-bold mb-1">Подготовка к курсу</h5>
                <p class="text-sm text-on-surface-variant">
                  Общение с Евгением перед началом VIP-комплекса.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
