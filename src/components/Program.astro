const spineImg =
  "https://lh3.googleusercontent.com/aida-public/AB6AXuCFGG966U9LORD77jD-65fNBC9xNFG76rKin5i2NrnMKoV7-7u1Z9DpeajmmsDBfOf7M8UwgHmIgekWsC0XkeQYBccp2jOCpipy3uNZtbazjBLsA-aCtLfLTGrCYhbdVZ3w_FwwDynbMxBpyrFC47WF-FAh-HUR2NAmtN3orL2oHguAaxoUmWatdHNxUgXktyeRBfmWj_Ee--iL0k7LibJ3y8F-ipiACeEe3hkD9LZDgo4i94rvVdjNLLckq9yQmzXzEgfIauvkrD8";
---

<section
  class="relative py-stack-lg bg-charcoal-deep text-off-white overflow-hidden"
  id="program"
>
  <div class="absolute inset-0 opacity-10 flex items-center justify-center">
    <img
      alt=""
      class="w-full h-full object-contain parallax-bg"
      data-parallax-speed="0.1"
      src={spineImg}
      style="transform: translate3d(0px, 0px, 0px);"
    />
  </div>
  <div
    class="relative px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto z-10"
  >
    <div class="max-w-3xl mb-stack-md reveal">
      <span
        class="font-label-sm text-label-sm text-emerald-electric mb-4 block uppercase font-bold"
        >Программа приёма</span
      >
      <h2 class="font-headline-lg text-headline-lg mb-6">
        VIP-комплекс — это не разовая процедура,<br />
        а <span class="text-emerald-electric italic">выстроенный процесс</span>
      </h2>
      <p class="font-body-lg text-off-white/70">
        Мы последовательно подготавливаем тело, снимаем поверхностные и
        глубокие зажимы, запускаем детокс и восстановление — чтобы каждая
        следующая техника работала максимально эффективно и безопасно.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-gutter">
      {
        stages.map((s) => (
          <div class="reveal glass-nav rounded-xl p-8 border border-emerald-electric/20 hover:border-emerald-electric/60 transition-soft">
            <div class="flex items-center gap-3 mb-4 flex-wrap">
              <span class="font-label-sm text-label-sm text-emerald-electric uppercase tracking-widest">
                {s.label}
              </span>
              {s.duration && (
                <span class="font-label-sm text-label-sm text-charcoal-deep px-2 py-1 bg-emerald-electric/30 rounded-full">
                  {s.duration}
                </span>
              )}
            </div>
            <h3 class="font-headline-md text-2xl text-charcoal-deep mb-3">
              {s.title}
            </h3>
            <p class="font-body-md text-secondary leading-relaxed">{s.body}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-stack-md max-w-3xl reveal">
      <p class="font-body-lg text-off-white/70 italic">
        В процессе работы мастер может добавлять дополнительные техники, если
        это необходимо для усиления эффекта и более точной работы с состоянием
        тела.
      </p>
    </div>
  </div>
</section>
