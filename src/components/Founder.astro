---
const portraitKsenia =
  "https://lh3.googleusercontent.com/aida-public/AB6AXuBq9un9zWISPYM8YW_PK6p1uPlY1NfBroeeU_DyhX5awPcot9gpKwshmivBLNH_OjqmL3HP5o1RfEi5hpUdeToAlLm8ssPo9R2apRq9nqNm-gXRSgYsblDVSuWF7fRkvMDReOH2L5tJIhqznFSUs_KGEjMs25Mp8YpdT3vPbLp_61Tf_Wys5mI4FTAmvPClHq4dB6PAlNJDpwGUHRBBWda0ax18A1zUmwa2fzumbcAmEKASMwyYBNZrxSA1ZK1gqNAgdocjEOMdhL8";
---

<section class="py-stack-lg bg-off-white" id="about">
  <div class="px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-stack-md items-center">
      <div class="relative group reveal">
        <div
          class="absolute -inset-4 bg-emerald-electric/10 rounded-xl -rotate-2 group-hover:rotate-0 transition-transform duration-500"
        >
        </div>
        <img
          alt="Ксения и Евгений Ерофеевы"
          class="relative w-full aspect-[4/5] object-cover rounded-xl shadow-2xl"
          src={portraitKsenia}
        />
        <div class="absolute bottom-6 left-6 right-6 p-6 glass-nav rounded-lg">
          <h3 class="font-headline-md text-headline-md text-charcoal-deep mb-1">
            Чета Ерофеевых
          </h3>
          <p class="font-label-sm text-label-sm text-secondary">
            Ксения и Евгений — авторы метода
          </p>
        </div>
      </div>
      <div class="reveal">
        <span
          class="font-label-sm text-label-sm text-emerald-electric mb-4 block uppercase font-bold"
        >О нас</span>
        <h2
          class="font-headline-lg text-headline-lg text-charcoal-deep mb-8"
        >
          Целители, которые ведут вас<br />
          <span class="text-primary italic">от первой беседы</span> до завершающего ЛФК
        </h2>
        <p class="font-body-lg text-body-lg text-secondary mb-8 leading-relaxed">
          <span class="font-bold text-charcoal-deep">Ксения Ерофеева</span> — потомственный лекарь, мастер
          вакуумной и висцеральной терапии. 20 лет ведёт системную телесную
          практику: жидкости → фасции и мышцы → позвоночник → органы.
        </p>
        <p class="font-body-lg text-body-lg text-secondary mb-10 leading-relaxed">
          <span class="font-bold text-charcoal-deep">Евгений Ерофеев</span> — специалист по психосоматике.
          Проводит подготовительное общение перед курсом, чтобы учесть
          психоэмоциональный фон и биологические реакции тела.
        </p>
        <div class="grid grid-cols-2 gap-gutter border-t border-outline-variant pt-10">
          <div>
            <span class="font-display-lg text-display-lg text-emerald-electric block">20</span>
            <p class="font-label-sm text-label-sm text-secondary uppercase">
              лет телесной практики
            </p>
          </div>
          <div>
            <span class="font-display-lg text-display-lg text-emerald-electric block">1000+</span>
            <p class="font-label-sm text-label-sm text-secondary uppercase">
              благодарных гостей
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
