---
const items = [
  { icon: "egg", title: "Мясо и яйца", body: "От проверенных хозяйств станицы." },
  { icon: "icecream", title: "Молочка", body: "Свежее козье молоко и фермерский сыр." },
  { icon: "nutrition", title: "Овощи и фрукты", body: "Сезонные продукты Краснодарского края." },
  { icon: "local_florist", title: "Мёд и травы", body: "Основа дневного режима гостя." },
];
---

<section class="py-section-gap-lg bg-surface">
  <div class="max-w-container-max mx-auto px-margin-mobile md:px-gutter">
    <div class="grid md:grid-cols-2 gap-16">
      <div class="reveal">
        <span
          class="font-label-caps text-label-caps text-primary mb-4 block uppercase"
          >Питание</span
        >
        <h2
          class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-surface mb-8"
        >
          Эко-продукция от <br />
          местных фермеров
        </h2>
        <p class="font-body-lg text-body-lg text-on-surface-variant mb-6">
          Сбалансированное специальное питание — обязательная часть восстановления.
          Мы знаем, у кого берём каждую банку молока и каждое яйцо.
        </p>
        <p class="text-on-surface-variant/70">
          Разнообразное меню обсуждается индивидуально — подберём персональный
          рацион с учётом ваших задач и предпочтений.
        </p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        {
          items.map((c) => (
            <div class="reveal p-8 bg-surface-container rounded-2xl">
              <span class="material-symbols-outlined text-primary mb-4">
                {c.icon}
              </span>
              <h4 class="font-bold text-on-surface mb-2">{c.title}</h4>
              <p class="text-sm text-on-surface-variant">{c.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
