---
const days = [
  {
    num: 1,
    title: "Заезд и знакомство",
    items: [
      { label: "Заезд и размещение", time: "14:00" },
      { label: "Ужин" },
      { label: "Консультация с Ксенией", featured: true },
      { label: "Психосоматика с Евгением" },
      { label: "Фитобочка с травами" },
    ],
  },
  {
    num: 2,
    title: "Глубокая работа",
    items: [
      { label: "ЛФК", time: "08:00" },
      { label: "Завтрак" },
      { label: "Висцеральный массаж", featured: true },
      { label: "Прогулка" },
      { label: "Обед" },
      { label: "Вакуумная процедура", featured: true },
      { label: "Солевая ванна" },
      { label: "Ужин" },
    ],
  },
  {
    num: 3,
    title: "Закрепление",
    items: [
      { label: "ЛФК" },
      { label: "Завтрак" },
      { label: "Гирудотерапия", featured: true },
      { label: "Обед" },
      { label: "Чайная медитация" },
      { label: "Отъезд", time: "16:00" },
    ],
  },
];
---

<section class="py-section-gap-lg bg-surface" id="schedule">
  <div class="max-w-container-max mx-auto px-margin-mobile md:px-gutter">
    <div class="mb-16 reveal">
      <span
        class="font-label-caps text-label-caps text-primary mb-4 block uppercase"
        >Расписание</span
      >
      <h2
        class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-surface mb-6"
      >
        Пример расписания на 3 дня
      </h2>
      <p class="text-on-surface-variant/70">
        Формат «Выходные с Ерофеевыми». Возможна коррекция процедур под ваш
        запрос.
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
      {
        days.map((d) => (
          <div class="reveal">
            <div class="flex items-center gap-4 mb-8">
              <span class="w-10 h-10 rounded-full bg-primary text-on-primary flex items-center justify-center font-bold">
                {d.num}
              </span>
              <h4 class="font-headline-sm text-headline-sm text-on-surface">
                {d.title}
              </h4>
            </div>
            <ul class="space-y-4 border-l-2 border-surface-container ml-5 pl-8">
              {d.items.map((it, idx) => (
                <li
                  class={`flex justify-between items-center py-2 ${idx < d.items.length - 1 ? "border-b border-surface-container/50" : ""} ${it.featured ? "text-on-surface font-bold" : ""}`}
                >
                  <span class={it.featured ? "" : "text-on-surface-variant"}>
                    {it.label}
                  </span>
                  {it.time && (
                    <span class="font-label-caps text-label-caps text-tertiary">
                      {it.time}
                    </span>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
