---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const heroImg = `${base}/izba.jpg`;
---

<section
  class="relative min-h-[90vh] flex items-center overflow-hidden bg-primary-container text-on-primary-container"
>
  <div class="absolute inset-0 opacity-10 mix-blend-overlay">
    <img alt="" class="w-full h-full object-cover" src={heroImg} />
  </div>
  <div
    class="max-w-container-max mx-auto px-margin-mobile md:px-gutter relative z-10 grid md:grid-cols-2 gap-12 items-center w-full"
  >
    <div class="reveal">
      <span
        class="font-label-caps text-label-caps text-on-primary-fixed-variant mb-4 block uppercase"
      >Izba.Vit • Станица Смоленская</span>
      <h1
        class="font-display-hero text-display-hero-mobile md:text-display-hero mb-6 text-on-primary-container"
      >
        Глубокая системная <span class="text-primary font-bold not-italic">перезагрузка</span> тела с четой Ерофеевых
      </h1>
      <p
        class="font-body-lg text-body-lg text-on-primary-container/80 max-w-lg mb-10"
      >
        Мы приводим организм в физиологически сбалансированное состояние, при
        котором восстанавливается согласованная работа ключевых систем — и тело
        переходит из режима компенсации в режим самовосстановления.
      </p>
      <div class="flex flex-wrap gap-4">
        <a
          class="bg-primary text-on-primary px-8 py-4 rounded-lg font-bold hover:bg-on-primary-container hover:text-on-primary transition-all"
          href="#contact"
        >
          Записаться на приём
        </a>
        <a
          class="border border-on-primary-container/30 text-on-primary-container px-8 py-4 rounded-lg font-bold hover:bg-on-primary-container/10 transition-all"
          href="#program"
        >
          Узнать программу
        </a>
      </div>
    </div>
    <div class="hidden md:block reveal">
      <div class="relative group">
        <div
          class="absolute -inset-4 border border-primary/20 rounded-2xl group-hover:-inset-6 transition-all duration-700"
        >
        </div>
        <img
          alt="Peaceful high-end retreat environment"
          class="rounded-2xl shadow-2xl relative z-10 w-full aspect-square object-cover"
          src={heroImg}
        />
      </div>
    </div>
  </div>
</section>
