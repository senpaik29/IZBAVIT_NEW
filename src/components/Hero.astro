---
const heroImg =
  "https://lh3.googleusercontent.com/aida-public/AB6AXuA2xLrRWnN_gCUGnKQgCb7lGlGa0AFobMGqhNIKQ7STyhbAIkZymHcti5H3i3yVEccZfVO90kG-QJku0a8_BPWZi57FVAlgMogbRsD7uLkHuJFynTDWZwe-GvRMCmeH7688Xd-t4pJ1gfuJpuZDAxdmWxV38Ed0PovY1M9zaVJxTPZrIKzM3DNRowRqm1TiCAKD7VIel_9118ZKrfG1Slaf_SfmFmbmu6wFLEqD0sGdRDV8X2YFnTKkme17qU-rnQQryDNLwijoI1E";
---

<section
  class="relative min-h-[90vh] flex items-center overflow-hidden bg-charcoal-deep text-off-white"
>
  <div class="absolute inset-0 opacity-40">
    <img
      alt="Advanced biological recovery and structural integrity focus"
      class="w-full h-full object-cover parallax-bg"
      data-parallax-speed="0.2"
      src={heroImg}
      style="transform: translate3d(0px, 0px, 0px);"
    />
  </div>
  <div
    class="relative w-full px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto py-stack-lg"
  >
    <div class="max-w-4xl reveal">
      <span
        class="inline-block font-label-sm text-label-sm text-emerald-electric mb-6 tracking-widest uppercase"
      >Пространство оздоровления</span>
      <h1
        class="font-display-lg text-display-lg md:text-display-lg text-off-white mb-8 leading-tight"
      >
        Здоровье — это не борьба. Это <span
          class="text-emerald-electric italic">возвращение</span> к норме.
      </h1>
      <p class="font-body-lg text-body-lg text-off-white/80 mb-10 max-w-2xl">
        Мы не работаем с симптомами. Мы возвращаем телу физиологические условия,
        в которых оно способно к самоисцелению.
      </p>
      <div class="flex flex-col sm:flex-row gap-gutter">
        <a
          class="bg-emerald-electric text-charcoal-deep font-bold px-10 py-5 rounded-full text-center vibrating-button transition-soft"
          href="#contact"
        >
          Начать восстановление
        </a>
        <a
          class="border-2 border-off-white/30 text-off-white font-bold px-10 py-5 rounded-full text-center hover:bg-off-white/10 transition-soft"
          href="#formula"
        >
          Узнать о методе
        </a>
      </div>
    </div>
  </div>
</section>
