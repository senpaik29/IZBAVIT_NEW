---
const systems = [
  {
    icon: "water_drop",
    step: "01",
    title: "Лимфатическая система",
    body: "Свободный лимфоток — главное условие очищения тканей и работы иммунитета.",
  },
  {
    icon: "favorite",
    step: "02",
    title: "Кровообращение и микроциркуляция",
    body: "Питание каждой клетки и вывод продуктов обмена через капиллярную сеть.",
  },
  {
    icon: "fitness_center",
    step: "03",
    title: "Мышечно-фасциальные цепи",
    body: "Мышцы выходят из хронического гипертонуса, фасции возвращают эластичность и скольжение.",
  },
  {
    icon: "vertical_align_center",
    step: "04",
    title: "Костно-суставная структура и позвоночник",
    body: "Позвоночник освобождается от избыточного давления, органы получают адекватную иннервацию.",
  },
];
---

<section class="py-stack-lg bg-surface" id="balance">
  <div
    class="px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto text-center mb-stack-md reveal"
  >
    <span
      class="font-label-sm text-label-sm text-emerald-electric mb-4 block uppercase font-bold"
      >Метод</span
    >
    <h2 class="font-headline-lg text-headline-lg text-charcoal-deep">
      Что приводим в <span class="italic text-primary">физиологический баланс</span>
    </h2>
    <p class="font-body-lg text-body-lg text-secondary max-w-3xl mx-auto mt-6">
      Мы работаем не с симптомом, а с базовыми системами. Через нормализацию
      этих уровней восстанавливается функция внутренних органов, гормональная
      регуляция, работа нервной системы и обменные процессы.
    </p>
  </div>
  <div class="px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-gutter">
      {
        systems.map((s) => (
          <div class="reveal bg-white p-8 rounded-xl border border-outline-variant/30 hover:border-emerald-electric/50 transition-soft group">
            <div class="w-14 h-14 bg-off-white rounded-full flex items-center justify-center mb-6 group-hover:bg-emerald-electric/10 transition-soft">
              <span class="material-symbols-outlined text-emerald-electric text-3xl">
                {s.icon}
              </span>
            </div>
            <span class="font-label-sm text-label-sm text-emerald-electric block mb-3">
              {s.step}
            </span>
            <h3 class="font-headline-md text-2xl text-charcoal-deep mb-4">
              {s.title}
            </h3>
            <p class="font-body-md text-body-md text-secondary leading-relaxed">
              {s.body}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
