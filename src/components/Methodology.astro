---
const systems = [
  {
    icon: "water_drop",
    step: "01",
    title: "Лимфатическая система",
    body: "Свободный лимфоток — главное условие очищения тканей и работы иммунитета.",
  },
  {
    icon: "favorite",
    step: "02",
    title: "Кровообращение",
    body: "Питание каждой клетки и вывод продуктов обмена через капиллярную сеть.",
  },
  {
    icon: "fitness_center",
    step: "03",
    title: "Мышечно-фасциальные цепи",
    body: "Мышцы выходят из хронического гипертонуса, фасции возвращают эластичность.",
  },
  {
    icon: "vertical_align_center",
    step: "04",
    title: "Позвоночник",
    body: "Позвоночник освобождается от избыточного давления, органы получают иннервацию.",
  },
];
---

<section class="py-section-gap-lg bg-surface" id="method">
  <div
    class="max-w-container-max mx-auto px-margin-mobile md:px-gutter text-center mb-16 reveal"
  >
    <span
      class="font-label-caps text-label-caps text-primary mb-4 block uppercase"
      >Метод</span
    >
    <h2
      class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-surface"
    >
      Что приводим в физиологический баланс
    </h2>
    <p class="max-w-2xl mx-auto mt-6 text-on-surface-variant">
      Мы работаем не с симптомом, а с базовыми системами. Через нормализацию этих
      уровней восстанавливается функция внутренних органов и обменные процессы.
    </p>
  </div>
  <div
    class="max-w-container-max mx-auto px-margin-mobile md:px-gutter grid grid-cols-1 md:grid-cols-4 gap-8"
  >
    {
      systems.map((s) => (
        <div class="reveal p-10 bg-surface-container rounded-2xl border-t-2 border-primary/10 hover:border-primary transition-all duration-500 group">
          <span class="material-symbols-outlined text-primary text-4xl mb-6 block">
            {s.icon}
          </span>
          <p class="font-label-caps text-label-caps text-tertiary mb-2">
            {s.step}
          </p>
          <h3 class="font-headline-sm text-headline-sm mb-4 text-on-surface">
            {s.title}
          </h3>
          <p class="text-on-surface-variant">{s.body}</p>
        </div>
      ))
    }
  </div>
</section>
