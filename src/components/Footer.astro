---
const year = new Date().getFullYear();
const footerLinks = [
  { href: "#about", label: "О нас" },
  { href: "#program", label: "Программа" },
  { href: "#procedures", label: "Процедуры" },
  { href: "#formats", label: "Форматы" },
  { href: "#contact", label: "Контакты" },
];
---

<footer
  class="bg-off-white border-t border-outline-variant py-stack-md"
>
  <div
    class="grid grid-cols-1 md:grid-cols-2 gap-gutter px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto items-center"
  >
    <div>
      <a class="inline-flex items-center gap-3 mb-6" href="#">
        <img src="/logo.png" alt="IzbaVit" class="h-12 w-auto" width="48" height="48" />
        <span
          class="font-label-sm text-[10px] tracking-[0.2em] text-secondary uppercase font-bold"
        >Станица Смоленская</span>
      </a>
      <p class="font-body-md text-secondary mb-2">
        VIP-приём Ксении Ерофеевой · Краснодарский край
      </p>
      <a class="font-body-md text-charcoal-deep font-bold hover:text-emerald-electric transition-colors" href="tel:+79155889235">
        +7 915 588-92-35
      </a>
      <p class="font-label-sm text-label-sm text-secondary mt-6 uppercase">
        © {year} IzbaVit. Все права защищены.
      </p>
    </div>
    <div class="flex flex-wrap gap-8 md:justify-end">
      {
        footerLinks.map((l) => (
          <a
            class="font-label-sm text-label-sm text-secondary hover:text-emerald-electric transition-colors uppercase tracking-widest"
            href={l.href}
          >
            {l.label}
          </a>
        ))
      }
    </div>
  </div>
</footer>
