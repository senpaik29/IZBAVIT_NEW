---
import logoSvg from "~/assets/logo.svg?raw";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const socials = [
  { icon: "send", label: "Telegram", href: "https://t.me/izba_vit" },
  {
    icon: "smartphone",
    label: "WhatsApp",
    href: "https://api.whatsapp.com/send?phone=79155889235",
  },
  {
    icon: "alternate_email",
    label: "Instagram",
    href: "https://api.whatsapp.com/send?phone=79155889235",
  },
];

const legal = [
  { label: "Политика конфиденциальности", href: `${base}/privacy` },
  { label: "Публичная оферта", href: `${base}/offer` },
];
---

<footer class="bg-surface-container-high border-t border-outline/10">
  <div
    class="px-margin-mobile md:px-gutter py-stack-lg"
  >
    <div class="grid md:grid-cols-3 gap-12 mb-12">
      <div>
        <span
          class="block h-16 mb-4 [&>svg]:h-full [&>svg]:w-auto"
          set:html={logoSvg}
        />
        <p class="font-body-md text-body-md text-on-surface-variant/70 mb-4">
          Глубокая системная перезагрузка тела с четой Ерофеевых.
        </p>
        <p class="font-label-caps text-label-caps text-on-surface-variant/60 uppercase">
          Станица Смоленская · Краснодарский край
        </p>
      </div>

      <div>
        <h4
          class="font-label-caps text-label-caps text-primary uppercase mb-4"
        >
          Связаться
        </h4>
        <a
          class="block font-headline-sm text-[20px] font-bold text-on-surface hover:text-primary transition-colors mb-4"
          href="tel:+79155889235"
        >
          +7 915 588-92-35
        </a>
        <div class="flex flex-wrap gap-3">
          {
            socials.map((s) => (
              <a
                class="inline-flex items-center gap-2 px-4 py-2 bg-surface rounded-full border border-outline/20 hover:border-primary hover:text-primary transition-colors text-sm font-bold"
                href={s.href}
                rel="noopener"
                target={s.href.startsWith("http") ? "_blank" : undefined}
              >
                <span class="material-symbols-outlined text-base">
                  {s.icon}
                </span>
                {s.label}
              </a>
            ))
          }
        </div>
      </div>

      <div>
        <h4
          class="font-label-caps text-label-caps text-primary uppercase mb-4"
        >
          Документы
        </h4>
        <ul class="space-y-3">
          {
            legal.map((l) => (
              <li>
                <a
                  class="text-on-surface-variant hover:text-primary transition-colors text-sm"
                  href={l.href}
                >
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div
      class="border-t border-outline/10 pt-6 flex flex-col md:flex-row justify-between items-start md:items-center gap-4"
    >
      <p class="font-label-caps text-label-caps text-on-surface-variant/60">
        © 2026 Оздоровление в станице. Все права защищены.
      </p>
      <a
        class="font-label-caps text-label-caps text-on-surface-variant/60 hover:text-primary transition-colors uppercase"
        href="#"
      >
        Izba.Vit · senpaik29.github.io/IZBAVIT_NEW
      </a>
    </div>
  </div>
</footer>
