---
const year = new Date().getFullYear();
const footerLinks = [
  "Privacy Policy",
  "Terms of Service",
  "Consultation",
  "Expert Profiles",
];
---

<footer
  class="bg-off-white dark:bg-charcoal-deep border-t border-outline-variant py-stack-md"
>
  <div
    class="grid grid-cols-1 md:grid-cols-2 gap-gutter px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto items-center"
  >
    <div>
      <a class="inline-flex items-center gap-2 mb-6" href="#">
        <span
          class="font-headline-md text-headline-md font-bold text-charcoal-deep dark:text-off-white"
        >Vitality Lab</span>
      </a>
      <p class="font-label-sm text-label-sm text-secondary mb-2 uppercase">
        © {year} Vitality Lab. Clinical Precision. Organic Vitality.
      </p>
    </div>
    <div class="flex flex-wrap gap-8 md:justify-end">
      {
        footerLinks.map((l) => (
          <a
            class="font-label-sm text-label-sm text-secondary hover:text-emerald-electric transition-colors"
            href="#"
          >
            {l}
          </a>
        ))
      }
    </div>
  </div>
</footer>
