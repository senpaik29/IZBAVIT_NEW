---
import logoSvg from "~/assets/logo.svg?raw";

const year = new Date().getFullYear();
const links = ["Privacy Policy", "Terms of Service", "Instagram", "WhatsApp"];
---

<footer class="bg-surface-container-high border-t border-outline/10">
  <div
    class="flex flex-col md:flex-row justify-between items-start md:items-center w-full px-margin-mobile md:px-gutter py-12 max-w-container-max mx-auto"
  >
    <div class="mb-8 md:mb-0">
      <span
        class="block h-16 mb-4 [&>svg]:h-full [&>svg]:w-auto"
        set:html={logoSvg}
      />
      <p class="font-body-md text-body-md text-on-surface-variant/60">
        Holistic Health &amp; VIP Restoration.
      </p>
    </div>
    <div class="grid grid-cols-2 md:flex gap-x-12 gap-y-4 mb-8 md:mb-0">
      {
        links.map((l) => (
          <a
            class="font-label-caps text-label-caps text-on-surface-variant/60 hover:text-primary transition-colors"
            href="#"
          >
            {l}
          </a>
        ))
      }
    </div>
    <p class="font-label-caps text-label-caps text-on-surface-variant/40">
      © {year} Ksenia Erofeeva. All rights reserved.
    </p>
  </div>
</footer>
