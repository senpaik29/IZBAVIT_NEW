---
const regions = [
  {
    num: "01",
    title: "Шейный отдел",
    body: "Устранение отёчности, головных болей и панических атак через восстановление циркуляции.",
  },
  {
    num: "02",
    title: "Грудной отдел",
    body: "Работа с дыханием, тревожностью и хронической усталостью. Снятие межрёберных зажимов.",
  },
  {
    num: "03",
    title: "Поясница и таз",
    body: "Устранение варикоза, болей в пояснице и восстановление функции органов малого таза.",
  },
];

const spineImg =
  "https://lh3.googleusercontent.com/aida-public/AB6AXuCFGG966U9LORD77jD-65fNBC9xNFG76rKin5i2NrnMKoV7-7u1Z9DpeajmmsDBfOf7M8UwgHmIgekWsC0XkeQYBccp2jOCpipy3uNZtbazjBLsA-aCtLfLTGrCYhbdVZ3w_FwwDynbMxBpyrFC47WF-FAh-HUR2NAmtN3orL2oHguAaxoUmWatdHNxUgXktyeRBfmWj_Ee--iL0k7LibJ3y8F-ipiACeEe3hkD9LZDgo4i94rvVdjNLLckq9yQmzXzEgfIauvkrD8";
---

<section
  class="relative py-stack-lg bg-charcoal-deep text-off-white overflow-hidden"
  id="spine"
>
  <div class="absolute inset-0 opacity-20 flex items-center justify-center">
    <img
      alt="Medical illustration of a human skeletal structure"
      class="w-full h-full object-contain parallax-bg"
      data-parallax-speed="0.1"
      src={spineImg}
      style="transform: translate3d(0px, 0px, 0px);"
    />
  </div>
  <div
    class="relative px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto z-10"
  >
    <div class="flex flex-col lg:flex-row gap-stack-md items-start">
      <div class="lg:w-1/2 reveal">
        <span
          class="font-label-sm text-label-sm text-emerald-electric mb-4 block uppercase font-bold"
          >Работа с позвоночником</span
        >
        <h2 class="font-headline-lg text-headline-lg mb-8">
          Когда тело ровное —<br />
          <span class="text-emerald-electric italic">органы работают</span>
        </h2>
        <div class="space-y-12">
          {
            regions.map((r, i) => (
              <div
                class={`flex gap-6 reveal ${i > 0 ? "border-t border-off-white/10 pt-10" : ""}`}
              >
                <span class="font-label-sm text-label-sm text-emerald-electric shrink-0 mt-1">
                  {r.num}
                </span>
                <div>
                  <h4 class="font-headline-md text-headline-md mb-3">{r.title}</h4>
                  <p class="font-body-md text-off-white/70">{r.body}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
      <div
        class="lg:w-1/2 relative min-h-[400px] w-full flex items-center justify-center p-gutter reveal"
      >
        <div
          class="relative glass-nav p-10 rounded-xl border border-emerald-electric/20 max-w-md"
        >
          <span class="material-symbols-outlined text-emerald-electric text-4xl mb-6"
            >vacuum</span
          >
          <h3 class="font-headline-md text-headline-md text-charcoal-deep mb-4">
            Вакуумная терапия
          </h3>
          <p class="font-body-md text-secondary leading-relaxed mb-6">
            Ключевой инструмент для безопасного снятия спазмов и восстановления
            физиологичной циркуляции.
          </p>
          <blockquote
            class="border-l-4 border-emerald-electric pl-6 italic text-charcoal-deep font-body-lg"
          >
            «Симметричное тело — это про свободный кровоток и полноценную иннервацию.»
          </blockquote>
        </div>
      </div>
    </div>
  </div>
</section>
