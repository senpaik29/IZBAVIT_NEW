---
import logoSvg from "~/assets/logo.svg?raw";

const links = [
  { href: "#about", label: "О нас" },
  { href: "#procedures", label: "Методы" },
  { href: "#nutrition", label: "Питание" },
  { href: "#formats", label: "Форматы" },
  { href: "#location", label: "Станица" },
  { href: "#testimonials", label: "Отзывы" },
];
---

<header
  class="bg-surface/90 backdrop-blur-md sticky top-0 z-50 border-b border-outline/10"
  id="site-header"
>
  <div
    class="flex justify-between items-center w-full px-margin-mobile md:px-gutter h-28"
  >
    <a
      class="flex items-center text-primary [&>span>svg]:h-full [&>span>svg]:w-auto"
      href="#"
      aria-label="IzbaVit"
    >
      <span class="block h-20 md:h-24" set:html={logoSvg} />
    </a>
    <nav class="hidden md:flex items-center gap-stack-lg">
      {
        links.map((l) => (
          <a
            class="font-label-caps text-[0.9375rem] text-on-surface/70 hover:text-primary transition-all duration-300"
            href={l.href}
          >
            {l.label}
          </a>
        ))
      }
    </nav>
    <a
      class="bg-primary text-on-primary px-8 py-3 rounded font-label-caps text-xs hover:opacity-90 transition-opacity"
      href="#contact"
    >
      Записаться
    </a>
  </div>
  <nav
    aria-label="Разделы сайта"
    class="md:hidden overflow-x-auto border-t border-outline/10 max-h-0 opacity-0 transition-all duration-300 ease-out"
    id="mobile-nav"
  >
    <div class="flex items-center gap-6 px-margin-mobile py-3 whitespace-nowrap">
      {
        links.map((l) => (
          <a
            class="font-label-caps text-[0.9375rem] text-on-surface/70 hover:text-primary transition-colors duration-300 shrink-0"
            href={l.href}
          >
            {l.label}
          </a>
        ))
      }
    </div>
  </nav>
</header>

<script is:inline>
  (() => {
    const nav = document.getElementById("mobile-nav");
    if (!nav) return;
    const onScroll = () => {
      if (window.scrollY > 100) {
        nav.classList.remove("max-h-0", "opacity-0");
        nav.classList.add("max-h-16", "opacity-100");
      } else {
        nav.classList.add("max-h-0", "opacity-0");
        nav.classList.remove("max-h-16", "opacity-100");
      }
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  })();
</script>
