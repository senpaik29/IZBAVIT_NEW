---
const links = [
  { href: "#about", label: "О нас" },
  { href: "#balance", label: "Метод" },
  { href: "#program", label: "Программа" },
  { href: "#procedures", label: "Процедуры" },
  { href: "#formats", label: "Форматы" },
];
---

<nav
  class="fixed top-0 w-full z-50 glass-nav border-b border-outline-variant/20 h-20 flex items-center"
>
  <div
    class="flex justify-between items-center w-full px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto"
  >
    <a class="flex items-center gap-3" href="#" aria-label="IzbaVit — Станица Смоленская">
      <img
        src="/logo.png"
        alt="IzbaVit"
        class="h-14 w-auto"
        width="56"
        height="56"
      />
      <span
        class="hidden sm:block font-label-sm text-[10px] tracking-[0.2em] text-secondary uppercase font-bold"
      >Станица Смоленская</span>
    </a>
    <div class="hidden md:flex items-center gap-8">
      {
        links.map((l) => (
          <a
            class="font-body-md text-on-surface-variant hover:text-emerald-electric transition-colors"
            href={l.href}
          >
            {l.label}
          </a>
        ))
      }
    </div>
    <a
      class="bg-emerald-electric text-charcoal-deep font-bold px-6 py-3 rounded-full vibrating-button transition-soft hover:opacity-90"
      href="#contact"
    >
      Записаться
    </a>
  </div>
</nav>
