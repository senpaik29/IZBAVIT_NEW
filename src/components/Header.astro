---
import logoSvg from "~/assets/logo.svg?raw";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const links = [
  { href: `${base}/#about`, label: "О нас" },
  { href: `${base}/#procedures`, label: "Методы" },
  { href: `${base}/#nutrition`, label: "Питание" },
  { href: `${base}/#formats`, label: "Форматы" },
  { href: `${base}/#testimonials`, label: "Отзывы" },
  { href: `${base}/#location`, label: "Станица" },
];
---

<header
  class="bg-surface/90 backdrop-blur-md sticky top-0 z-50 border-b border-outline/10"
  id="site-header"
>
  <div
    class="flex justify-between items-center w-full px-margin-mobile md:px-gutter h-28"
  >
    <a
      class="flex items-center text-primary [&>span>svg]:h-full [&>span>svg]:w-auto"
      href={`${base}/`}
      aria-label="IzbaVit"
    >
      <span class="block h-20 md:h-24" set:html={logoSvg} />
    </a>
    <nav class="hidden md:flex items-center gap-stack-lg">
      {
        links.map((l) => (
          <a
            class="font-label-caps text-[0.9375rem] text-on-surface/70 hover:text-primary transition-all duration-300"
            href={l.href}
          >
            {l.label}
          </a>
        ))
      }
    </nav>
    <a
      class="bg-primary text-on-primary px-8 py-3 rounded font-label-caps text-[0.975rem] hover:opacity-90 transition-opacity"
      href={`${base}/#contact`}
    >
      Записаться
    </a>
  </div>
  <div class="md:hidden relative">
    <nav
      aria-label="Разделы сайта"
      class="overflow-x-auto border-t border-outline/10 max-h-0 opacity-0 transition-all duration-300 ease-out mobile-nav-scroll"
      id="mobile-nav"
    >
      <div class="flex items-center gap-6 px-margin-mobile pt-3 pb-3 whitespace-nowrap">
        {
          links.map((l) => (
            <a
              class="font-label-caps text-[0.9375rem] text-on-surface/70 hover:text-primary transition-colors duration-300 shrink-0"
              href={l.href}
            >
              {l.label}
            </a>
          ))
        }
      </div>
    </nav>
    <div
      aria-hidden="true"
      class="pointer-events-none absolute left-3 right-3 bottom-1 h-[3px] rounded-full bg-on-surface/10 opacity-0 transition-opacity duration-300"
      id="mobile-nav-track"
    >
      <div
        class="absolute top-0 bottom-0 left-0 rounded-full bg-primary/70"
        id="mobile-nav-thumb"
        style="width: 30%;"
      >
      </div>
    </div>
    <div
      aria-hidden="true"
      class="pointer-events-none absolute right-0 top-0 bottom-2 w-10 bg-gradient-to-l from-surface/95 to-transparent opacity-0 transition-opacity duration-300"
      id="mobile-nav-fade"
    >
    </div>
  </div>
</header>

<style is:global>
  .mobile-nav-scroll {
    scrollbar-width: none;
  }
  .mobile-nav-scroll::-webkit-scrollbar {
    display: none;
  }
</style>

<script is:inline>
  (() => {
    const nav = document.getElementById("mobile-nav");
    const fade = document.getElementById("mobile-nav-fade");
    const track = document.getElementById("mobile-nav-track");
    const thumb = document.getElementById("mobile-nav-thumb");
    if (!nav) return;

    const onPageScroll = () => {
      if (window.scrollY > 100) {
        nav.classList.remove("max-h-0", "opacity-0");
        nav.classList.add("max-h-16", "opacity-100");
      } else {
        nav.classList.add("max-h-0", "opacity-0");
        nav.classList.remove("max-h-16", "opacity-100");
      }
      updateIndicators();
    };

    const updateIndicators = () => {
      const navVisible = nav.classList.contains("opacity-100");
      const scrollable = nav.scrollWidth > nav.clientWidth + 1;
      const hasMore =
        nav.scrollLeft + nav.clientWidth < nav.scrollWidth - 4;

      if (fade) fade.style.opacity = navVisible && hasMore ? "1" : "0";

      if (track && thumb) {
        if (!navVisible || !scrollable) {
          track.style.opacity = "0";
        } else {
          track.style.opacity = "1";
          const widthPct = (nav.clientWidth / nav.scrollWidth) * 100;
          const maxScroll = nav.scrollWidth - nav.clientWidth;
          const leftPct =
            maxScroll > 0
              ? (nav.scrollLeft / maxScroll) * (100 - widthPct)
              : 0;
          thumb.style.width = `${widthPct}%`;
          thumb.style.left = `${leftPct}%`;
        }
      }
    };

    onPageScroll();
    window.addEventListener("scroll", onPageScroll, { passive: true });
    nav.addEventListener("scroll", updateIndicators, { passive: true });
    window.addEventListener("resize", updateIndicators);
  })();
</script>
