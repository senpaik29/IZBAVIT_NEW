---
import logoSvg from "~/assets/logo.svg?raw";

const links = [
  { href: "#method", label: "Метод" },
  { href: "#program", label: "Программа" },
  { href: "#procedures", label: "Техники" },
  { href: "#formats", label: "Форматы" },
  { href: "#schedule", label: "Расписание" },
];
---

<header
  class="bg-surface/90 backdrop-blur-md sticky top-0 z-50 border-b border-outline/10 h-28"
>
  <div
    class="flex justify-between items-center w-full px-margin-mobile md:px-gutter max-w-container-max mx-auto h-full"
  >
    <a
      class="flex items-center text-primary [&>span>svg]:h-full [&>span>svg]:w-auto"
      href="#"
      aria-label="IzbaVit"
    >
      <span class="block h-20 md:h-24" set:html={logoSvg} />
    </a>
    <nav class="hidden md:flex items-center gap-stack-lg">
      {
        links.map((l) => (
          <a
            class="font-label-caps text-label-caps text-on-surface/70 hover:text-primary transition-all duration-300"
            href={l.href}
          >
            {l.label}
          </a>
        ))
      }
    </nav>
    <a
      class="bg-primary text-on-primary px-6 py-2 rounded font-label-caps text-label-caps hover:opacity-90 transition-opacity"
      href="#contact"
    >
      Записаться
    </a>
  </div>
</header>
