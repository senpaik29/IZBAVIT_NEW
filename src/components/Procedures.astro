---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const categories = [
  {
    title: "Массаж и телесные практики",
    icon: "spa",
    items: [
      {
        title: "Баночный массаж",
        body: "Лимфодренаж, снятие мышечных спазмов, выброс эндорфинов, антицеллюлитный эффект.",
        photo: `${base}/banki.jpg`,
      },
      {
        title: "Висцеральная терапия",
        body: "Мягкая работа с внутренними органами, восстановление их подвижности, устранение болей в животе и спине.",
        photo: `${base}/visc.jpg`,
      },
      {
        title: "Коррекция малого таза",
        body: "Устранение перекоса таза и разницы в длине ног, облегчение болей в крестце и пояснице.",
      },
      {
        title: "Буккальный массаж",
        body: "Внутриротовой лифтинг лица, снятие челюстных зажимов, разглаживание носогубных складок.",
      },
      {
        title: "Гуаша",
        body: "Скребковый массаж, мощный детокс, омоложение кожи, активация иммунитета.",
      },
      {
        title: "Массаж полотенцами",
        body: "Глубокое влажное прогревание, снятие хронических спазмов, эйфория и тотальное расслабление.",
      },
      {
        title: "Массаж нагайками",
        body: "Вибростимуляция, эмоциональная разрядка, антицеллюлитный эффект, мощный выброс эндорфинов.",
      },
      {
        title: "Медовые вытяжки",
        body: "Вытяжки — выведение токсинов через кожу, глубокое питание, лифтинг и очищение.",
      },
    ],
  },
  {
    title: "Гирудотерапия",
    icon: "biotech",
    items: [
      {
        title: "Воздействие пиявками",
        body: "Разжижение крови, снятие воспаления и отёков, обезболивание, иммуномодуляция.",
        photo: `${base}/pijavki.png`,
      },
    ],
  },
  {
    title: "Двигательная реабилитация",
    icon: "fitness_center",
    items: [
      {
        title: "ЛФК",
        body: "Лечебная гимнастика для коррекции осанки, укрепления мышечного корсета и восстановления подвижности.",
      },
    ],
  },
  {
    title: "Тепловые процедуры",
    icon: "local_fire_department",
    items: [
      {
        title: "Фитобочка",
        body: "Кедровая бочка, глубокий прогрев, детокс, усиление микроциркуляции.",
      },
      {
        title: "Солевая ванна",
        body: "Минеральное насыщение, расслабление мышц, снятие отёков.",
        photo: `${base}/bath.jpg`,
      },
      {
        title: "Баня",
        body: "По желанию. Очищение, контрастное закаливание, глубокая релаксация.",
      },
    ],
  },
  {
    title: "Практики осознанности",
    icon: "self_improvement",
    items: [
      {
        title: "Дыхательные практики и медитации",
        body: "Снятие тревожности, гармонизация нервной системы, улучшение сна.",
      },
      {
        title: "Чайные церемонии",
        body: "Мягкое погружение в состояние «здесь и сейчас», антистресс-ритуал.",
        photo: `${base}/tea.jpg`,
      },
      {
        title: "Прогулки по живописным местам",
        body: "Насыщение природной энергией, мягкое восстановление душевного баланса.",
      },
    ],
  },
];
---

<section class="py-section-gap-lg bg-surface-container-low" id="procedures">
  <div class="px-margin-mobile md:px-gutter">
    <div class="mb-16 reveal">
      <span
        class="font-label-caps text-label-caps text-primary mb-4 block uppercase"
        >Наши методы оздоровления</span
      >
      <h2
        class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-surface mb-6"
      >
        Индивидуальный подход <br />
        <span class="italic font-normal text-primary">к каждому гостю</span>
      </h2>
      <p class="font-body-lg text-body-lg text-on-surface-variant max-w-3xl">
        Последовательность, сочетания и количество процедур определяются после
        консультации.
      </p>
    </div>

    <div
      class="reveal bg-surface p-10 rounded-2xl border-l-4 border-primary shadow-sm mb-16 max-w-4xl"
      id="diagnostics"
    >
      <div class="flex items-center gap-4 mb-6">
        <span class="material-symbols-outlined text-primary text-3xl"
          >search</span
        >
        <h3 class="font-headline-sm text-headline-sm text-on-surface">
          Диагностика и психосоматический разбор
        </h3>
      </div>
      <p class="font-body-lg text-body-lg text-on-surface-variant leading-relaxed mb-4">
        Начинаем с диагностики — определяем причину, а не работаем со
        следствиями. Обязательно проводим полный психосоматический разбор и
        регуляцию психофизического состояния.
      </p>
      <p class="text-on-surface-variant leading-relaxed">
        Ищем первопричины вашего недомогания, опираясь на понимание того, что
        телесные симптомы — не случайный сбой, а осмысленная биологическая
        программа, запущенная эмоциональным потрясением или внутренним
        конфликтом. Это помогает выстроить программу <strong
          class="text-on-surface">не на подавление симптомов, а на глубинное
          исцеление</strong
        >.
      </p>
    </div>

    <div class="space-y-12">
      {
        categories.map((cat) => (
          <div class="reveal">
            <div class="flex items-center gap-4 mb-8">
              <span class="material-symbols-outlined text-primary text-3xl">
                {cat.icon}
              </span>
              <h3 class="font-headline-sm text-headline-sm text-on-surface">
                {cat.title}
              </h3>
            </div>
            <div
              class={`grid grid-cols-1 sm:grid-cols-2 gap-6 ${cat.items.length >= 3 ? "lg:grid-cols-4" : "lg:grid-cols-3"}`}
            >
              {cat.items.map((it) => (
                <div class="bg-surface rounded-xl border border-outline/10 hover:shadow-xl transition-all overflow-hidden flex flex-col">
                  {it.photo && (
                    <img
                      alt={it.title}
                      class="w-full aspect-[4/3] object-cover"
                      src={it.photo}
                      loading="lazy"
                      decoding="async"
                    />
                  )}
                  <div class="p-8">
                    <h4 class="font-headline-sm text-[18px] mb-3 text-on-surface">
                      {it.title}
                    </h4>
                    <p class="text-sm text-on-surface-variant leading-relaxed">
                      {it.body}
                    </p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </div>

    <p class="mt-16 text-on-surface-variant/80 italic max-w-3xl reveal">
      Все процедуры подбираются индивидуально, исходя из вашей проблематики
      и запроса. Длительность, последовательность и количество сессий
      определяются на консультации.
    </p>
  </div>
</section>
