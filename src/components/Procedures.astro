---
const procedures = [
  { icon: "search", title: "Диагностика", body: "Системный взгляд на причину состояния перед стартом." },
  { icon: "spa", title: "Гуаша", body: "Скребковая техника для активации лимфы." },
  { icon: "face", title: "Букальный массаж", body: "Глубокая работа с лицевыми мышцами изнутри." },
  { icon: "self_improvement", title: "Нагаечный массаж", body: "Старинная казачья практика мягких ударов." },
  { icon: "footprint", title: "Работа со ступнями", body: "Вакуумная проработка рефлекторных зон." },
  { icon: "biotech", title: "Гирудотерапия", body: "Разгрузка венозной системы пиявками." },
  { icon: "local_fire_department", title: "Огненный массаж", body: "Глубокий прогрев тканей открытым огнём." },
  { icon: "spa", title: "Медовая ладка", body: "Детокс кожи и тканей медовой техникой." },
  { icon: "deck", title: "Баня", body: "Контрастный тепловой стресс для сосудов." },
  { icon: "self_improvement", title: "Медитации", body: "Дыхательные практики и чайные церемонии." },
];
---

<section class="py-section-gap-lg bg-surface-container-low" id="procedures">
  <div class="max-w-container-max mx-auto px-margin-mobile md:px-gutter">
    <div class="flex flex-col md:flex-row justify-between items-end mb-16 gap-8 reveal">
      <div class="max-w-2xl">
        <span
          class="font-label-caps text-label-caps text-primary mb-4 block uppercase"
          >Процедуры</span
        >
        <h2
          class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-surface"
        >
          Дополнительные техники <br />
          по запросу
        </h2>
      </div>
      <p class="text-on-surface-variant max-w-sm">
        Каждая техника усиливает результат основного курса и точечно работает с
        конкретными состояниями тела.
      </p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6">
      {
        procedures.map((p) => (
          <div class="reveal bg-surface p-8 rounded-xl border border-outline/10 hover:shadow-xl transition-all group">
            <span class="material-symbols-outlined text-primary mb-6 block group-hover:scale-110 transition-transform">
              {p.icon}
            </span>
            <h3 class="font-headline-sm text-[20px] mb-3 text-on-surface">
              {p.title}
            </h3>
            <p class="text-sm text-on-surface-variant">{p.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
