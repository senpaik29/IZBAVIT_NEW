---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Header from "~/components/Header.astro";
import Footer from "~/components/Footer.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout title="Спасибо! — Izba.Vit">
  <Header />
  <main>
    <section
      class="py-section-gap-lg bg-primary-container text-on-primary-container min-h-[70vh] flex items-center"
    >
      <div class="px-margin-mobile md:px-gutter w-full">
        <div class="max-w-2xl mx-auto text-center reveal">
          <span
            class="material-symbols-outlined text-primary text-[72px] mb-6 block"
          >
            check_circle
          </span>
          <h1
            class="font-display-lg text-display-lg-mobile md:text-display-lg mb-6 text-on-primary-container"
          >
            Благодарим Вас!
          </h1>
          <p
            class="font-body-lg text-body-lg text-on-primary-container/80 mb-12"
          >
            Ваша заявка принята. Администратор свяжется с&nbsp;вами
            в&nbsp;ближайшее время!
          </p>
          <a
            class="inline-flex items-center gap-3 bg-primary text-on-primary px-8 py-4 rounded-full font-label-caps text-label-caps hover:opacity-90 transition-opacity"
            href={`${base}/`}
          >
            <span class="material-symbols-outlined text-base">arrow_back</span>
            Вернуться на главную
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
