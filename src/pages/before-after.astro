---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Header from "~/components/Header.astro";
import Footer from "~/components/Footer.astro";
import BeforeAfter from "~/components/BeforeAfter.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout title="До и после — Izba.Vit">
  <Header />
  <main>
    <div class="px-margin-mobile md:px-gutter pt-12">
      <a
        class="inline-flex items-center gap-2 text-primary font-label-caps text-label-caps hover:gap-3 transition-all"
        href={`${base}/`}
      >
        <span class="material-symbols-outlined text-base">arrow_back</span>
        На главную
      </a>
    </div>
    <BeforeAfter />
  </main>
  <Footer />
</BaseLayout>
