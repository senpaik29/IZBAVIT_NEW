---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Header from "~/components/Header.astro";
import Footer from "~/components/Footer.astro";

const principles = [
  {
    icon: "science",
    title: "Без мистики",
    body: "Только ясная логика, понятная телу и уму. Работа на стыке биологии, физиологии и психики.",
  },
  {
    icon: "account_tree",
    title: "Причинно-следственная связь",
    body: "Находим конкретное событие, которое запустило адаптационную реакцию. Убираем причину — симптом перестаёт быть нужным телу.",
  },
  {
    icon: "psychology",
    title: "Биология выживания",
    body: "Опираемся на доказанные механизмы адаптации тела, а не на абстрактные интерпретации.",
  },
  {
    icon: "favorite",
    title: "Подготовка к курсу",
    body: "Подготовительное общение проходит до старта VIP-комплекса и задаёт настройку всей телесной работе.",
  },
];
---

<BaseLayout title="Евгений Ерофеев — Специалист по психосоматике">
  <Header />
  <main>
    <!-- Hero -->
    <section
      class="relative pt-24 pb-section-gap-sm bg-primary-container text-on-primary-container overflow-hidden"
    >
      <div
        class="max-w-container-max mx-auto px-margin-mobile md:px-gutter relative z-10 grid md:grid-cols-12 gap-16 items-center w-full"
      >
        <div class="md:col-span-7 reveal">
          <span
            class="font-label-caps text-label-caps text-on-primary-fixed-variant mb-4 block uppercase"
            >Специалист по психосоматике</span
          >
          <h1
            class="font-display-hero text-display-hero-mobile md:text-display-hero mb-6 text-on-primary-container"
          >
            Евгений <span class="text-primary font-bold not-italic">Ерофеев</span>
          </h1>
          <p
            class="font-body-lg text-body-lg text-on-primary-container/80 max-w-xl mb-10"
          >
            За каждым диагнозом стоит событие. Евгений помогает увидеть это
            событие до начала телесной работы, чтобы программа Ксении прошла
            глубже и закрепилась надолго.
          </p>
          <div class="flex flex-wrap gap-4">
            <a
              class="bg-primary text-on-primary px-8 py-4 rounded-lg font-bold hover:bg-on-primary-container hover:text-on-primary transition-all"
              href="/IZBAVIT_NEW/#contact"
            >
              Записаться на приём
            </a>
            <a
              class="border border-on-primary-container/30 text-on-primary-container px-8 py-4 rounded-lg font-bold hover:bg-on-primary-container/10 transition-all"
              href="/IZBAVIT_NEW/"
            >
              На главную
            </a>
          </div>
        </div>
        <div class="md:col-span-5 hidden md:block reveal">
          <div class="relative aspect-[4/5] rounded-2xl overflow-hidden shadow-2xl">
            <img
              alt="Евгений Ерофеев"
              class="w-full h-full object-cover"
              src="/eugene.png"
            />
            <div class="absolute inset-0 ring-1 ring-inset ring-black/5 rounded-2xl"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- Bio -->
    <section class="py-section-gap-lg bg-surface-container-low">
      <div class="max-w-container-max mx-auto px-margin-mobile md:px-gutter">
        <div class="grid md:grid-cols-12 gap-16 items-start">
          <div class="md:col-span-7 reveal">
            <span
              class="font-label-caps text-label-caps text-primary mb-4 block uppercase"
              >О специалисте</span
            >
            <h2
              class="font-headline-lg text-headline-lg-mobile md:text-headline-lg mb-10 text-on-surface"
            >
              Тело не болеет случайно
            </h2>
            <div class="space-y-6 text-on-surface/80 mb-12">
              <p class="font-body-lg text-body-lg">
                Евгений Ерофеев — специалист по психосоматике. Он работает с
                <strong class="text-on-surface">причинно-следственной связью</strong>
                между событиями жизни и сигналами тела. Любой симптом — это
                адаптационная реакция организма: стрессовое событие запускает
                цепочку «психика → мозг → тело».
              </p>
              <p class="font-body-lg text-body-lg">
                Перед началом курса Ксении Евгений проводит индивидуальную
                беседу. Эта подготовка учитывает психоэмоциональный фон и
                биологические реакции тела, которые могут влиять на напряжение
                и восстановление.
              </p>
              <p class="font-body-lg text-body-lg">
                Когда конфликт разрешён — нервная система выходит из режима
                выживания, тело перестаёт удерживать напряжение, и запускаются
                процессы естественного восстановления. Именно поэтому
                подготовительное общение усиливает эффект всех последующих
                этапов VIP-комплекса.
              </p>
            </div>
            <div class="flex flex-col sm:flex-row gap-12">
              <div>
                <p class="font-stat-number text-stat-number text-primary">15+</p>
                <p class="font-label-caps text-label-caps text-tertiary">
                  лет работы с психосоматикой
                </p>
              </div>
              <div>
                <p class="font-stat-number text-stat-number text-primary">
                  100%
                </p>
                <p class="font-label-caps text-label-caps text-tertiary">
                  индивидуальный формат
                </p>
              </div>
            </div>
          </div>
          <div class="md:col-span-5 reveal">
            <div class="bg-surface p-8 rounded-2xl border border-outline/10">
              <span
                class="font-label-caps text-label-caps text-primary mb-6 block uppercase"
                >Принципы работы</span
              >
              <div class="space-y-8">
                {
                  principles.map((p) => (
                    <div class="flex gap-4">
                      <span class="material-symbols-outlined text-primary shrink-0">
                        {p.icon}
                      </span>
                      <div>
                        <h5 class="text-on-surface font-bold mb-1">{p.title}</h5>
                        <p class="text-sm text-on-surface-variant leading-relaxed">
                          {p.body}
                        </p>
                      </div>
                    </div>
                  ))
                }
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Couple CTA -->
    <section
      class="py-section-gap-sm bg-surface-container-high text-on-surface"
    >
      <div
        class="max-w-container-max mx-auto px-margin-mobile md:px-gutter text-center reveal"
      >
        <span
          class="font-label-caps text-label-caps text-primary mb-4 block uppercase"
          >Чета Ерофеевых</span
        >
        <h2
          class="font-headline-lg text-headline-lg-mobile md:text-headline-lg mb-6 max-w-3xl mx-auto"
        >
          Целители, которые ведут вас <br />
          <span class="italic font-normal text-primary"
            >от первой беседы до завершающего ЛФК</span
          >
        </h2>
        <p class="font-body-lg text-on-surface-variant max-w-2xl mx-auto mb-10">
          Психосоматика Евгения подготавливает почву, телесная практика Ксении
          запускает перезагрузку. Вместе — это законченный путь восстановления.
        </p>
        <a
          class="inline-block bg-primary text-on-primary px-8 py-4 rounded-lg font-bold hover:opacity-90 transition-opacity"
          href="/IZBAVIT_NEW/#contact"
        >
          Записаться на VIP-комплекс
        </a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
